# Desenvolvimento. Para produção, seguir PRODUCTION.md; não copiar defaults locais.
APP_ENV=development
AUTH_COOKIE_SECURE=false
CORS_ORIGENS=["http://localhost:5173"]
# Jogo não precisa aquecer embeddings nem de chave LLM.
AQUECER_NA_INICIALIZACAO=false
# DB_AUTH / DB_PROGRESSO: caminhos absolutos distintos em volume persistente na produção.
# MASTERS_CACHE_PATH: caminho absoluto persistente; também lido do .env.
# DOCS_DIR / CHROMA_DIR / LOG_GUARDRAILS: caminhos persistentes se tutor habilitado.
# Copie este arquivo para .env e preencha. NUNCA faça commit do .env.

# Provedor do LLM: openai | anthropic | ollama
LLM_PROVIDER=anthropic

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos Claude (usados quando LLM_PROVIDER=anthropic)
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-4-5-20251001

OLLAMA_MODEL=llama3.1

# Caminho do executável do Stockfish (no macOS com Homebrew: /opt/homebrew/bin/stockfish)
STOCKFISH_PATH=stockfish

# Similaridade mínima para aceitar um trecho recuperado (0 a 1)
MIN_SCORE=0.79

# Token para POST /ingest (vazio = rota desativada). Gere um valor aleatório longo.
ADMIN_TOKEN=
